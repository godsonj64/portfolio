# Optional but recommended: raises the GitHub API limit from 60/h to 5,000/h.
# Create a fine-grained token with read-only "Contents" + "Metadata" on the public repos you list in src/content/repos.ts.
GITHUB_TOKEN=

# Shared secret for the push webhook at /api/revalidate (set the same value in GitHub -> Settings -> Webhooks).
GITHUB_WEBHOOK_SECRET=
